# Entorno general
    NODE_ENV=development
    NEXT_PUBLIC_SITE_URL=http://localhost:3000
    
    # Base de Datos PostgreSQL (Supabase São Paulo - Modo Transaction Pooler puerto 6543)
    DATABASE_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
    
    # Supabase Auth y Storage
    NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
    NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
    SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
    
    # Mercado Pago Checkout Pro y Webhooks
    MP_ACCESS_TOKEN=APP_USR-...
    MP_WEBHOOK_SECRET=...
    
    # Resend (Emails transaccionales)
    RESEND_API_KEY=re_...